{
  "name": "docx-viewer-vscode",
  "displayName": "DOCX Viewer & ODT Viewer, Word Document Preview (Dark Mode)",
  "description": "Free and offline. DOCX viewer and Word viewer for VS Code: open .docx, .odt and old .doc files with dark mode, search and outline. Compare Word documents as a redline (DOCX compare and DOCX diff) and export track changes to Word.",
  "version": "0.4.2",
  "publisher": "zovo",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#16233F",
    "theme": "dark"
  },
  "homepage": "https://github.com/theluckystrike/docx-viewer-vscode#readme",
  "bugs": {
    "url": "https://github.com/theluckystrike/docx-viewer-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/theluckystrike/docx-viewer-vscode"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=18"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "docx",
    "docx viewer",
    "word viewer",
    "doc viewer",
    "microsoft word",
    "word document",
    "docx preview",
    "word preview",
    "document viewer",
    "document preview",
    "office viewer",
    "read docx",
    "open docx",
    "dotx",
    "docm",
    "doc",
    "word reader",
    "docx to markdown",
    "word to markdown",
    "docx to text",
    "docx diff",
    "docx reader",
    "odt",
    "odt viewer",
    "compare word documents",
    "docx compare",
    "word compare",
    "redline",
    "track changes",
    "document compare"
  ],
  "main": "./out/extension.js",
  "browser": "./out/web/extension.js",
  "activationEvents": [],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "docxViewer.preview",
        "displayName": "DOCX Viewer",
        "selector": [
          {
            "filenamePattern": "*.docx"
          },
          {
            "filenamePattern": "*.dotx"
          },
          {
            "filenamePattern": "*.docm"
          },
          {
            "filenamePattern": "*.odt"
          },
          {
            "filenamePattern": "*.ott"
          },
          {
            "filenamePattern": "*.doc"
          },
          {
            "filenamePattern": "*.dot"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "docxViewer.find",
        "title": "Find in Document",
        "category": "DOCX Viewer",
        "icon": "$(search)"
      },
      {
        "command": "docxViewer.copyAsMarkdown",
        "title": "Copy as Markdown",
        "category": "DOCX Viewer",
        "icon": "$(copy)"
      },
      {
        "command": "docxViewer.openAsText",
        "title": "Open as Text",
        "category": "DOCX Viewer",
        "icon": "$(file-text)"
      },
      {
        "command": "docxViewer.openAsMarkdown",
        "title": "Open as Markdown",
        "category": "DOCX Viewer",
        "icon": "$(markdown)"
      },
      {
        "command": "docxViewer.openInDefaultApp",
        "title": "Open in Default App",
        "category": "DOCX Viewer",
        "icon": "$(link-external)"
      },
      {
        "command": "docxViewer.compareWithHead",
        "title": "Compare with Git HEAD",
        "category": "DOCX Viewer",
        "icon": "$(git-compare)"
      },
      {
        "command": "docxViewer.compareWithDocument",
        "title": "Compare with Another Document...",
        "category": "DOCX Viewer",
        "icon": "$(diff)"
      },
      {
        "command": "docxViewer.compareRedline",
        "title": "Compare Documents (Redline)...",
        "category": "DOCX Viewer",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "docxViewer.compareWithHeadRedline",
        "title": "Redline against Git HEAD",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.exportRedlineDocx",
        "title": "Export Redline as DOCX with Tracked Changes (Pro)",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.exportRedlineHtml",
        "title": "Export Redline as HTML (Pro)",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.compareFolders",
        "title": "Compare Two Folders of Documents (Pro)...",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.openSample",
        "title": "Open Sample Document",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.toggleToolbar",
        "title": "Show or Hide the Toolbar",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.openWalkthrough",
        "title": "Get Started",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.supportDeveloper",
        "title": "Support the developer",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.moreViewers",
        "title": "More free viewers",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.unlockWithSponsors",
        "title": "Zovo: Unlock Pro with GitHub Sponsors",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.getPro",
        "title": "Zovo: Get Pro (USD 19 once, all Zovo viewers)",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.payWithPayPal",
        "title": "Zovo: Pay for Pro with PayPal (USD 19, team of 5 USD 59)",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.enterLicenseKey",
        "title": "Zovo: Enter License Key",
        "category": "DOCX Viewer"
      },
      {
        "command": "docxViewer.removeLicense",
        "title": "Zovo: Remove License from This Editor",
        "category": "DOCX Viewer"
      }
    ],
    "keybindings": [
      {
        "command": "docxViewer.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'docxViewer.preview'"
      },
      {
        "command": "docxViewer.toggleToolbar",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "activeCustomEditorId == 'docxViewer.preview'"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "docxViewer.copyAsMarkdown",
          "when": "activeCustomEditorId == 'docxViewer.preview'",
          "group": "navigation@1"
        },
        {
          "command": "docxViewer.openAsText",
          "when": "activeCustomEditorId == 'docxViewer.preview'",
          "group": "navigation@2"
        },
        {
          "command": "docxViewer.openAsMarkdown",
          "when": "activeCustomEditorId == 'docxViewer.preview'",
          "group": "1_docx@1"
        },
        {
          "command": "docxViewer.openInDefaultApp",
          "when": "activeCustomEditorId == 'docxViewer.preview' && !isWeb",
          "group": "1_docx@2"
        },
        {
          "command": "docxViewer.compareWithHead",
          "when": "activeCustomEditorId == 'docxViewer.preview' && isWorkspaceTrusted && !isWeb",
          "group": "1_docx@3"
        },
        {
          "command": "docxViewer.compareWithDocument",
          "when": "activeCustomEditorId == 'docxViewer.preview'",
          "group": "1_docx@4"
        },
        {
          "command": "docxViewer.compareRedline",
          "when": "activeCustomEditorId == 'docxViewer.preview' && !isWeb",
          "group": "1_docx@5"
        }
      ],
      "explorer/context": [
        {
          "command": "docxViewer.openAsText",
          "when": "resourceExtname =~ /^\\.(docx|dotx|docm|odt|ott|doc|dot)$/i",
          "group": "7_docx@1"
        },
        {
          "command": "docxViewer.copyAsMarkdown",
          "when": "resourceExtname =~ /^\\.(docx|dotx|docm|odt|ott|doc|dot)$/i",
          "group": "7_docx@2"
        },
        {
          "command": "docxViewer.compareWithHead",
          "when": "resourceExtname =~ /^\\.(docx|dotx|docm|odt|ott|doc|dot)$/i && !explorerResourceIsFolder && isWorkspaceTrusted && !isWeb",
          "group": "7_docx@3"
        },
        {
          "command": "docxViewer.compareWithDocument",
          "when": "resourceExtname =~ /^\\.(docx|dotx|docm|odt|ott|doc|dot)$/i && !explorerResourceIsFolder",
          "group": "7_docx@4"
        },
        {
          "command": "docxViewer.compareRedline",
          "when": "resourceExtname =~ /^\\.(docx|dotx|docm|odt|ott|doc|dot)$/i && !explorerResourceIsFolder && !isWeb",
          "group": "7_docx@5"
        },
        {
          "command": "docxViewer.compareFolders",
          "when": "explorerResourceIsFolder && !isWeb && config.docxViewer.showProFeatures",
          "group": "7_docx@6"
        }
      ],
      "commandPalette": [
        {
          "command": "docxViewer.find",
          "when": "activeCustomEditorId == 'docxViewer.preview'"
        },
        {
          "command": "docxViewer.toggleToolbar",
          "when": "activeCustomEditorId == 'docxViewer.preview'"
        },
        {
          "command": "docxViewer.compareWithHead",
          "when": "!isWeb"
        },
        {
          "command": "docxViewer.openInDefaultApp",
          "when": "!isWeb"
        },
        {
          "command": "docxViewer.exportRedlineDocx",
          "when": "activeWebviewPanelId == 'docxViewer.redline' && config.docxViewer.showProFeatures"
        },
        {
          "command": "docxViewer.exportRedlineHtml",
          "when": "activeWebviewPanelId == 'docxViewer.redline' && config.docxViewer.showProFeatures"
        },
        {
          "command": "docxViewer.compareRedline",
          "when": "!isWeb"
        },
        {
          "command": "docxViewer.compareWithHeadRedline",
          "when": "!isWeb"
        },
        {
          "command": "docxViewer.compareFolders",
          "when": "!isWeb && config.docxViewer.showProFeatures"
        },
        {
          "command": "docxViewer.getPro",
          "when": "!isWeb && config.docxViewer.showProFeatures"
        },
        {
          "command": "docxViewer.payWithPayPal",
          "when": "!isWeb && config.docxViewer.showProFeatures"
        },
        {
          "command": "docxViewer.unlockWithSponsors",
          "when": "!isWeb && config.docxViewer.showProFeatures"
        },
        {
          "command": "docxViewer.enterLicenseKey",
          "when": "!isWeb && config.docxViewer.showProFeatures"
        },
        {
          "command": "docxViewer.removeLicense",
          "when": "!isWeb && config.docxViewer.showProFeatures"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "docxViewer.compareWithHead",
          "when": "scmProvider == git && !isWeb && resourceExtname =~ /^\\.(docx|dotx|docm|odt|ott|doc|dot)$/i",
          "group": "navigation@99"
        }
      ]
    },
    "configuration": {
      "title": "DOCX Viewer",
      "properties": {
        "docxViewer.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the VS Code color theme",
            "White paper with dark text, like Word",
            "Dark page with light text"
          ],
          "default": "auto",
          "description": "Page colors for the document."
        },
        "docxViewer.defaultView": {
          "type": "string",
          "enum": [
            "reading",
            "page"
          ],
          "enumDescriptions": [
            "Text in one column that follows the window width, with dark mode and an outline",
            "Pages the way Word lays them out, with headers, footers, page size and fonts (.docx, .dotx and .docm)"
          ],
          "default": "reading",
          "description": "The view a Word file opens in. The Page view and Reading view buttons switch it for this workspace."
        },
        "docxViewer.zoom": {
          "type": "number",
          "default": 1,
          "minimum": 0.5,
          "maximum": 3,
          "description": "Zoom for both views, from 0.5 (50%) to 3 (300%). Ctrl+= and Ctrl+- (Cmd on macOS) change it in the viewer."
        },
        "docxViewer.fontFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "Font for Reading view. Leave empty for the Word-like default (Calibri or a close match), write `editor` to use your editor font, or give a font list such as `Georgia, serif`. Page view always uses the fonts of the document."
        },
        "docxViewer.pageViewMaxMB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Files larger than this open in Reading view, with a button to try Page view anyway. Page view needs more memory for big files."
        },
        "docxViewer.maxFileSizeMB": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "Files larger than this ask before they open, so VS Code stays responsive."
        },
        "docxViewer.maxImageSizeMB": {
          "type": "number",
          "default": 20,
          "minimum": 0.1,
          "description": "Images larger than this are replaced by a short placeholder."
        },
        "docxViewer.maxTotalImagesMB": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "After this many MB of images in one document, further images are replaced by placeholders."
        },
        "docxViewer.compareView": {
          "type": "string",
          "enum": [
            "ask",
            "redline",
            "markdown"
          ],
          "enumDescriptions": [
            "Ask each time which view to open",
            "The formatted redline with a change list (desktop VS Code)",
            "Markdown of both documents in the VS Code diff editor"
          ],
          "default": "ask",
          "description": "What \"Compare with Git HEAD\" and \"Compare with Another Document\" open."
        },
        "docxViewer.redlineFormatting": {
          "type": "boolean",
          "default": true,
          "description": "Mark formatting-only changes (bold, italic, underline, size, paragraph style) in the redline and write them as formatting revisions in the DOCX export."
        },
        "docxViewer.showProFeatures": {
          "type": "boolean",
          "default": true,
          "description": "Show the Zovo Pro features (redline export, folder compare) and the Zovo Pro commands. Turn off to hide them. Everything free stays visible."
        },
        "docxViewer.askForRating": {
          "type": "boolean",
          "default": true,
          "description": "Ask for a rating after 2 files opened without an error in 2 sessions at least 4 hours apart. \"Rate it\" opens the Marketplace review page in VS Code and the Open VSX one in Cursor, Windsurf and VSCodium. \"Later\" asks one more time after 7 days, \"No thanks\" never asks again. It never asks after an error or more than 2 times. Nothing is sent anywhere."
        },
        "docxViewer.showSupportLinks": {
          "type": "boolean",
          "default": true,
          "description": "Show the small Sponsor and More free viewers links at the bottom of the viewer. The change shows in files you open next. Nothing is sent anywhere."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "docxViewer.start",
        "title": "Get started with DOCX Viewer",
        "description": "Read Word documents inside VS Code, search them and copy them as Markdown.",
        "steps": [
          {
            "id": "open",
            "title": "Open a Word document",
            "description": "Click any .docx or .dotx file in the Explorer. It opens as a read-only preview.\n[Open the sample document](command:docxViewer.openSample)",
            "media": {
              "image": "images/screenshot-dark.png",
              "altText": "A Word report open in VS Code with the outline on the left and three search matches highlighted."
            },
            "completionEvents": [
              "onCommand:docxViewer.openSample"
            ]
          },
          {
            "id": "search",
            "title": "Search and jump",
            "description": "Press Ctrl+F (Cmd+F on macOS) to search. Enter goes to the next match, Shift+Enter to the previous one. Click a heading in the outline to jump to it.\n[Find in document](command:docxViewer.find)",
            "media": {
              "markdown": "walkthrough/search.md"
            },
            "completionEvents": [
              "onCommand:docxViewer.find"
            ]
          },
          {
            "id": "markdown",
            "title": "Copy as Markdown",
            "description": "Copy the whole document as Markdown with tables and footnotes, or open its plain text in a new editor.\n[Copy as Markdown](command:docxViewer.copyAsMarkdown)",
            "media": {
              "markdown": "walkthrough/markdown.md"
            },
            "completionEvents": [
              "onCommand:docxViewer.copyAsMarkdown",
              "onCommand:docxViewer.openAsText"
            ]
          },
          {
            "id": "redline",
            "title": "Compare two versions (redline)",
            "description": "Right-click a Word file and choose Compare Documents (Redline), or run Compare with Git HEAD. Insertions are underlined, deletions struck through, moved paragraphs and changed table cells are marked, and F7 steps through the changes.\n[Compare documents](command:docxViewer.compareRedline)",
            "media": {
              "image": "images/redline-dark.png",
              "altText": "Two versions of a services agreement compared in VS Code: insertions underlined in green, deletions struck through in red, a moved clause and changed table cells, with the change list on the left."
            },
            "completionEvents": [
              "onCommand:docxViewer.compareRedline",
              "onCommand:docxViewer.compareWithHead",
              "onCommand:docxViewer.compareWithDocument"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test test/*.test.js",
    "sample": "python3 scripts/make-sample.py",
    "screenshot": "node scripts/screenshot.js",
    "vscode:prepublish": "node scripts/build.js",
    "smoke": "scripts/smoke-vscode.sh",
    "package": "npx -y @vscode/vsce@3 package --no-dependencies -o dist/"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "docx-preview": "^0.4.1",
    "mammoth": "^1.13.0",
    "rtf.js": "^3.0.9",
    "utif": "^3.1.0",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^24.1.3"
  },
  "sponsor": {
    "url": "https://github.com/sponsors/theluckystrike"
  }
}
